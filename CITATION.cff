    given-names: Beknur
    affiliation: Nazarbayev University
repository-code: "https://github.com/miss-mississippi/alakazam"
license: MIT
version: 2.0.0
date-released: 2026-09-29
keywords:
  - atmospheric reentry
  - satellite demise
  - ablation
  - aluminium oxide
  - mesosphere
  - NRLMSIS
